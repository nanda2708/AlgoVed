PORT=8000
# Shared secret; must match COMPILER_API_KEY in backend/.env
COMPILER_API_KEY=replace-with-a-long-random-secret
# Programs compiled/executed in parallel, and how many may wait in the queue
MAX_CONCURRENT_RUNS=2
MAX_PENDING_RUNS=50
# Optional: enables the "Review code" button
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
