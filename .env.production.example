# Copy to .env.production next to docker-compose.prod.yml and fill in.
PUBLIC_URL=https://algoved.is-a.dev

# MongoDB Atlas. The cluster may be shared with other apps; AlgoVed uses its own database.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=algoved

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COMPILER_API_KEY=

MAX_CONCURRENT_RUNS=2
GEMINI_API_KEY=
SEED_ADMIN_PASSWORD=
