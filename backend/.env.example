PORT=5000

# MongoDB Atlas connection string (Database Access > your user). The cluster can be
# shared with other projects: AlgoVed always uses the database named below.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=algoved

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API and open sockets
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

COMPILER_API_URL=http://localhost:8000
COMPILER_API_KEY=replace-with-a-long-random-secret

# Set to 1 when running behind a reverse proxy such as nginx
TRUST_PROXY=

# Password for the seeded "admin" account (required when NODE_ENV=production)
SEED_ADMIN_PASSWORD=
